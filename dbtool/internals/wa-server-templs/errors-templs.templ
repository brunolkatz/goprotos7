package wa_server_templs

templ ErrorPage(title *string, msg string) {
	<div class="mx-auto max-w-4xl">
		@ErrorAlert(msg)
	</div>
}

templ SuccessAlert(msg string) {
	<div class="rounded-lg border border-emerald-500/40 bg-emerald-500/10 px-4 py-3 text-emerald-300" role="alert">
		@templ.Raw(msg)
	</div>
}

templ InfoAlert(msg string) {
	<div class="rounded-lg border border-sky-500/40 bg-sky-500/10 px-4 py-3 text-sky-300" role="alert">
		@templ.Raw(msg)
	</div>
}

templ WarningAlert(msg string) {
	<div class="rounded-lg border border-amber-500/40 bg-amber-500/10 px-4 py-3 text-amber-300" role="alert">
		@templ.Raw(msg)
	</div>
}

templ ErrorAlert(msg string) {
	<div class="rounded-lg border border-rose-500/40 bg-rose-500/10 px-4 py-3 text-rose-300" role="alert">
		@templ.Raw(msg)
	</div>
}
